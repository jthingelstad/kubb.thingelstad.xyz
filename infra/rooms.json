{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "kubb.thingelstad.xyz rooms: API Gateway WebSocket API, one Lambda function, one DynamoDB table for multiplayer rooms and the bucket their games are recorded in",
  "Parameters": {
    "CodeBucket": {
      "Type": "String",
      "Description": "S3 bucket holding the zipped handler bundle"
    },
    "CodeKey": {
      "Type": "String",
      "Description": "S3 key of the zipped bundle (index.mjs exporting handler)"
    },
    "AllowedOrigins": {
      "Type": "String",
      "Default": "https://throwingwood.com,https://app.throwingwood.com,http://localhost,http://127.0.0.1",
      "Description": "Comma separated Origin allow-list for new connections; an origin without a port allows any port"
    },
    "ReelsFunctionArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws[a-z-]*:lambda:[a-z0-9-]+:[0-9]{12}:function:[A-Za-z0-9_-]+$",
      "Description": "The highlight reel function (stack kubb-xyz-site output ReelsFunctionArn). Empty: every reel request is answered unavailable."
    },
    "ReelEngines": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[0-9]{1,4}\\.[0-9]{1,4}(,[0-9]{1,4}\\.[0-9]{1,4})*$",
      "Description": "The engine major.minors the reel function renders (stack kubb-xyz-site output ReelEngines)."
    },
    "ApiCodeKey": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^api/[0-9a-f]{64}\\.zip$",
      "Description": "S3 key of the api function's zipped bundle (tools/api-bundle.mjs). Empty leaves the api function, its URL and the push secret out (pitchApi false in infra/deployment.json)."
    }
  },
  "Conditions": {
    "HasReels": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ReelsFunctionArn"
            },
            ""
          ]
        }
      ]
    },
    "HasApi": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ApiCodeKey" }, ""] }] }
  },
  "Resources": {
    "RoomsTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "exp",
          "Enabled": true
        }
      }
    },
    "GamesBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-games-${AWS::AccountId}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        }
      }
    },
    "GamesBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "GamesBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["GamesBucket", "Arn"]
                },
                {
                  "Fn::Sub": "${GamesBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "RoomsLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-rooms"
        },
        "RetentionInDays": 30
      }
    },
    "RoomsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Execution role for the kubb rooms function",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "rooms",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "RoomsTable",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:BatchWriteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": ["RoomsTable", "Arn"]
                  }
                },
                {
                  "Sid": "RecordGames",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${GamesBucket.Arn}/games/*"
                    },
                    {
                      "Fn::Sub": "${GamesBucket.Arn}/reports/*"
                    }
                  ]
                },
                {
                  "Sid": "Logs",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["RoomsLogGroup", "Arn"]
                  }
                },
                {
                  "Sid": "Connections",
                  "Effect": "Allow",
                  "Action": "execute-api:ManageConnections",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${RoomsApi}/prod/*/@connections/*"
                  }
                },
                {
                  "Fn::If": [
                    "HasReels",
                    {
                      "Sid": "StartReels",
                      "Effect": "Allow",
                      "Action": "lambda:InvokeFunction",
                      "Resource": {
                        "Ref": "ReelsFunctionArn"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "RoomsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-rooms"
        },
        "Description": "kubb.thingelstad.xyz room server: presence, one shared document, relay",
        "Runtime": "nodejs24.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": {
          "Fn::GetAtt": ["RoomsRole", "Arn"]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "RoomsLogGroup"
          },
          "LogFormat": "Text"
        },
        "Environment": {
          "Variables": {
            "TABLE": {
              "Ref": "RoomsTable"
            },
            "GAMES_BUCKET": {
              "Ref": "GamesBucket"
            },
            "ALLOWED_ORIGINS": {
              "Ref": "AllowedOrigins"
            },
            "NODE_OPTIONS": "--enable-source-maps",
            "REELS_FUNCTION": {
              "Ref": "ReelsFunctionArn"
            },
            "REEL_ENGINES": {
              "Ref": "ReelEngines"
            }
          }
        }
      }
    },
    "RoomsApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-rooms"
        },
        "Description": "kubb.thingelstad.xyz multiplayer rooms",
        "ProtocolType": "WEBSOCKET",
        "RouteSelectionExpression": "$request.body.action"
      }
    },
    "RoomsIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "RoomsApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${RoomsFunction.Arn}/invocations"
        }
      }
    },
    "ConnectRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "RoomsApi"
        },
        "RouteKey": "$connect",
        "Target": {
          "Fn::Sub": "integrations/${RoomsIntegration}"
        }
      }
    },
    "DisconnectRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "RoomsApi"
        },
        "RouteKey": "$disconnect",
        "Target": {
          "Fn::Sub": "integrations/${RoomsIntegration}"
        }
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "RoomsApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${RoomsIntegration}"
        }
      }
    },
    "RoomsInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "RoomsFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${RoomsApi}/*"
        }
      }
    },
    "RoomsStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "DependsOn": ["ConnectRoute", "DisconnectRoute", "DefaultRoute"],
      "Properties": {
        "ApiId": {
          "Ref": "RoomsApi"
        },
        "StageName": "prod",
        "Description": "Production stage, throttled for a hobby game",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingRateLimit": 50,
          "ThrottlingBurstLimit": 100
        },
        "RouteSettings": {
          "$connect": {
            "ThrottlingRateLimit": 5,
            "ThrottlingBurstLimit": 20
          }
        }
      }
    },
    "PushSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Condition": "HasApi",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}/push-secret" },
        "Description": "Shared secret the pitch server signs its pushes to the api function with (HMAC-SHA256). Generated by Secrets Manager and copied by hand into the pitch server Worker.",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasApi",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-api" },
        "RetentionInDays": 30
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasApi",
      "Properties": {
        "Description": "Execution role for the kubb api function: pitch pushes, reports, replays, reels, shares",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "api",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "PitchItems",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": { "Fn::GetAtt": ["RoomsTable", "Arn"] },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "pitch#*",
                        "share#*",
                        "reels#*",
                        "shares#*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "RecordGames",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    { "Fn::Sub": "${GamesBucket.Arn}/games/pitch/*" },
                    { "Fn::Sub": "${GamesBucket.Arn}/games/browser/*" },
                    { "Fn::Sub": "${GamesBucket.Arn}/reports/*" }
                  ]
                },
                {
                  "Sid": "PushSecret",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": { "Ref": "PushSecret" }
                },
                {
                  "Sid": "Logs",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": { "Fn::GetAtt": ["ApiLogGroup", "Arn"] }
                },
                {
                  "Fn::If": [
                    "HasReels",
                    {
                      "Sid": "Reels",
                      "Effect": "Allow",
                      "Action": "lambda:InvokeFunction",
                      "Resource": { "Ref": "ReelsFunctionArn" }
                    },
                    { "Ref": "AWS::NoValue" }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasApi",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-api" },
        "Description": "Throwing Wood api: signed pitch pushes, reports, recorded matches, replays, reels and shares over HTTPS",
        "Runtime": "nodejs24.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": 10,
        "Role": { "Fn::GetAtt": ["ApiRole", "Arn"] },
        "Code": {
          "S3Bucket": { "Ref": "CodeBucket" },
          "S3Key": { "Ref": "ApiCodeKey" }
        },
        "LoggingConfig": {
          "LogGroup": { "Ref": "ApiLogGroup" },
          "LogFormat": "Text"
        },
        "Environment": {
          "Variables": {
            "TABLE": { "Ref": "RoomsTable" },
            "GAMES_BUCKET": { "Ref": "GamesBucket" },
            "ALLOWED_ORIGINS": { "Ref": "AllowedOrigins" },
            "PUSH_SECRET_ARN": { "Ref": "PushSecret" },
            "REELS_FUNCTION": { "Ref": "ReelsFunctionArn" },
            "REEL_ENGINES": { "Ref": "ReelEngines" },
            "NODE_OPTIONS": "--enable-source-maps"
          }
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Condition": "HasApi",
      "Properties": {
        "TargetFunctionArn": { "Ref": "ApiFunction" },
        "AuthType": "NONE"
      }
    },
    "ApiUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasApi",
      "Properties": {
        "FunctionName": { "Ref": "ApiFunction" },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ApiUrlInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasApi",
      "Properties": {
        "FunctionName": { "Ref": "ApiFunction" },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "WebSocketUrl": {
      "Description": "The rooms endpoint for the client",
      "Value": {
        "Fn::Sub": "wss://${RoomsApi}.execute-api.${AWS::Region}.amazonaws.com/prod"
      }
    },
    "ApiId": {
      "Value": {
        "Ref": "RoomsApi"
      }
    },
    "TableName": {
      "Value": {
        "Ref": "RoomsTable"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "RoomsFunction"
      }
    },
    "GamesBucket": {
      "Description": "Every committed room document version, kept for good",
      "Value": {
        "Ref": "GamesBucket"
      }
    },
    "ApiUrl": {
      "Condition": "HasApi",
      "Description": "The api function URL: the pitch server pushes to <url>push, and CloudFront sends /api/* here",
      "Value": { "Fn::GetAtt": ["ApiUrl", "FunctionUrl"] }
    },
    "ApiFunctionName": {
      "Condition": "HasApi",
      "Value": { "Ref": "ApiFunction" }
    },
    "PushSecretArn": {
      "Condition": "HasApi",
      "Description": "The push secret's ARN (never its value)",
      "Value": { "Ref": "PushSecret" }
    }
  }
}
