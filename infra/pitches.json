{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Throwing Wood pitches: the api function the pitch server pushes to and the apps call over HTTPS, its URL, role, logs and push secret, the table of pitch records and the private bucket recorded games and reports go to",
  "Parameters": {
    "CodeBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+",
      "Description": "S3 bucket holding the zipped api bundle (the site stack's code bucket)"
    },
    "ApiCodeKey": {
      "Type": "String",
      "AllowedPattern": "^api/[0-9a-f]{64}\\.zip$",
      "Description": "S3 key of the api function's zipped bundle (tools/api-bundle.mjs)"
    },
    "AllowedOrigins": {
      "Type": "String",
      "Default": "https://throwingwood.com,https://app.throwingwood.com,http://localhost,http://127.0.0.1",
      "Description": "Comma separated Origin allow-list for the apps' calls; an origin without a port allows any port"
    },
    "ReelsFunctionArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws[a-z-]*:lambda:[a-z0-9-]+:[0-9]{12}:function:[A-Za-z0-9_-]+$",
      "Description": "The highlight reel function (site stack output ReelsFunctionArn). Empty: every reel and share request is answered unavailable."
    },
    "ReelEngines": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[0-9]{1,4}\\.[0-9]{1,4}(,[0-9]{1,4}\\.[0-9]{1,4})*$",
      "Description": "The engine major.minors the reel function renders (site stack output ReelEngines)."
    }
  },
  "Conditions": {
    "HasReels": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ReelsFunctionArn" }, ""] }]
    }
  },
  "Resources": {
    "PitchesTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          { "AttributeName": "pk", "AttributeType": "S" },
          { "AttributeName": "sk", "AttributeType": "S" }
        ],
        "KeySchema": [
          { "AttributeName": "pk", "KeyType": "HASH" },
          { "AttributeName": "sk", "KeyType": "RANGE" }
        ],
        "TimeToLiveSpecification": { "AttributeName": "exp", "Enabled": true }
      }
    },
    "GamesBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-games-${AWS::AccountId}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DevPushesExpire",
              "Status": "Enabled",
              "Prefix": "games/dev/",
              "ExpirationInDays": 14
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        }
      }
    },
    "GamesBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "GamesBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["GamesBucket", "Arn"] },
                { "Fn::Sub": "${GamesBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "PushSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "throwing-wood/push-secret",
        "Description": "Shared secret the pitch server signs its pushes to the api function with (HMAC-SHA256). Generated by Secrets Manager and copied by hand into the pitch server Worker.",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      }
    },
    "DevKey": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "throwing-wood/pitch-dev-key",
        "Description": "Bearer key for the dev pitch server Worker's /dev/pitch. Generated by Secrets Manager; backend/pitch-server/deploy.sh reads it for a dev deploy. Never set on the production Worker.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/throwing-wood-api",
        "RetentionInDays": 30
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Execution role for the Throwing Wood api function: pitch pushes, reports, replays, reels, shares",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "api",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "PitchItems",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": { "Fn::GetAtt": ["PitchesTable", "Arn"] },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "pitch#*",
                        "share#*",
                        "reels#*",
                        "shares#*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "RecordGames",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    { "Fn::Sub": "${GamesBucket.Arn}/games/pitch/*" },
                    { "Fn::Sub": "${GamesBucket.Arn}/games/dev/pitch/*" },
                    { "Fn::Sub": "${GamesBucket.Arn}/games/browser/*" },
                    { "Fn::Sub": "${GamesBucket.Arn}/reports/*" }
                  ]
                },
                {
                  "Sid": "PushSecret",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": { "Ref": "PushSecret" }
                },
                {
                  "Sid": "Logs",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": { "Fn::GetAtt": ["ApiLogGroup", "Arn"] }
                },
                {
                  "Fn::If": [
                    "HasReels",
                    {
                      "Sid": "Reels",
                      "Effect": "Allow",
                      "Action": "lambda:InvokeFunction",
                      "Resource": { "Ref": "ReelsFunctionArn" }
                    },
                    { "Ref": "AWS::NoValue" }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "throwing-wood-api",
        "Description": "Throwing Wood api: signed pitch pushes, reports, recorded matches, replays, reels and shares over HTTPS",
        "Runtime": "nodejs24.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": 10,
        "Role": { "Fn::GetAtt": ["ApiRole", "Arn"] },
        "Code": {
          "S3Bucket": { "Ref": "CodeBucket" },
          "S3Key": { "Ref": "ApiCodeKey" }
        },
        "LoggingConfig": {
          "LogGroup": { "Ref": "ApiLogGroup" },
          "LogFormat": "Text"
        },
        "Environment": {
          "Variables": {
            "TABLE": { "Ref": "PitchesTable" },
            "GAMES_BUCKET": { "Ref": "GamesBucket" },
            "ALLOWED_ORIGINS": { "Ref": "AllowedOrigins" },
            "PUSH_SECRET_ARN": { "Ref": "PushSecret" },
            "REELS_FUNCTION": { "Ref": "ReelsFunctionArn" },
            "REEL_ENGINES": { "Ref": "ReelEngines" },
            "NODE_OPTIONS": "--enable-source-maps"
          }
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": { "Ref": "ApiFunction" },
        "AuthType": "NONE"
      }
    },
    "ApiUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "ApiFunction" },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ApiUrlInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "ApiFunction" },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Description": "The api function URL: the pitch server pushes to <url>push, and CloudFront sends /api/* here",
      "Value": { "Fn::GetAtt": ["ApiUrl", "FunctionUrl"] },
      "Export": { "Name": "throwing-wood-api-url" }
    },
    "ApiFunctionName": {
      "Value": { "Ref": "ApiFunction" },
      "Export": { "Name": "throwing-wood-api-function" }
    },
    "PushSecretArn": {
      "Description": "The push secret's ARN (never its value)",
      "Value": { "Ref": "PushSecret" },
      "Export": { "Name": "throwing-wood-push-secret-arn" }
    },
    "TableName": {
      "Description": "The pitch, share and reel records the api function writes and the pitch pages and reel function read",
      "Value": { "Ref": "PitchesTable" },
      "Export": { "Name": "throwing-wood-pitches-table" }
    },
    "GamesBucket": {
      "Description": "Every push, one-device match and report, kept for good",
      "Value": { "Ref": "GamesBucket" },
      "Export": { "Name": "throwing-wood-pitches-games-bucket" }
    }
  }
}
