{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kubb: Throwing Wood at throwingwood.com, with www and the old kubb.thingelstad.xyz redirecting to it: private S3 origin, CloudFront, certificate, DNS records and access log",
  "Parameters": {
    "HostedZoneId": {
      "Type": "String",
      "Default": "Z00131847XOTS27DSIZF",
      "Description": "The thingelstad.xyz hosted zone (stack dns-thingelstad-xyz in projects-sysadmin)"
    },
    "PagesCodeKey": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^pages/[0-9a-f]{64}\\.zip$",
      "Description": "The pitch pages function's package in the code bucket (tools/pages-bundle.mjs). Empty leaves the function out: /p/, /e/ and /og/ are the static pages."
    },
    "PitchTable": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[A-Za-z0-9_.-]+$",
      "Description": "The table the pages and reel functions read: the pitches table (stack throwing-wood-pitches output TableName). Empty leaves both functions out."
    },
    "ReelsCodeKey": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^reels/[0-9a-f]{64}\\.zip$",
      "Description": "The highlight reel function's package in the code bucket (tools/reels-bundle.mjs). Empty leaves the reel function out."
    },
    "ReelsLayerKey": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^reels/ffmpeg-[0-9a-f]{64}\\.zip$",
      "Description": "The reel function's ffmpeg layer in the code bucket (tools/reels-bundle.mjs, pinned in infra/reels-pins.json). Empty leaves the reel function out."
    },
    "ReelEngines": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[0-9]{1,4}\\.[0-9]{1,4}(,[0-9]{1,4}\\.[0-9]{1,4})*$",
      "Description": "The engine major.minors the reel function renders (its packaged engine's). Empty leaves the reel function out."
    },
    "ApiDomain": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9]+\\.lambda-url\\.[a-z0-9-]+\\.on\\.aws$",
      "Description": "The api function URL's host (stack throwing-wood-pitches output ApiUrl). Empty: no /api/* route."
    }
  },
  "Conditions": {
    "HasPages": {
      "Fn::And": [
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "PagesCodeKey" }, ""] }] },
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "PitchTable" }, ""] }] }
      ]
    },
    "HasReels": {
      "Fn::And": [
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ReelsCodeKey" }, ""] }] },
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ReelsLayerKey" }, ""] }] },
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ReelEngines" }, ""] }] },
        { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "PitchTable" }, ""] }] }
      ]
    },
    "HasApi": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ApiDomain" }, ""] }] }
  },
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "throwingwood.com",
        "SubjectAlternativeNames": [
          "www.throwingwood.com",
          "kubb.thingelstad.xyz"
        ],
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": "throwingwood.com",
            "HostedZoneId": {
              "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
            }
          },
          {
            "DomainName": "www.throwingwood.com",
            "HostedZoneId": {
              "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
            }
          },
          {
            "DomainName": "kubb.thingelstad.xyz",
            "HostedZoneId": { "Ref": "HostedZoneId" }
          }
        ]
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Fn::Sub": "${AWS::StackName}-web-${AWS::AccountId}" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            },
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": { "NoncurrentDays": 30 },
              "ExpiredObjectDeleteMarker": true
            },
            {
              "Id": "ExpireReels",
              "Status": "Enabled",
              "Prefix": "reels/",
              "ExpirationInDays": 366
            }
          ]
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "SiteBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["SiteBucket", "Arn"] },
                { "Fn::Sub": "${SiteBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            },
            {
              "Sid": "CloudFrontReadsWebsite",
              "Effect": "Allow",
              "Principal": { "Service": "cloudfront.amazonaws.com" },
              "Action": "s3:GetObject",
              "Resource": { "Fn::Sub": "${SiteBucket.Arn}/*" },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Sid": "CloudFrontListsWebsiteForTrue404s",
              "Effect": "Allow",
              "Principal": { "Service": "cloudfront.amazonaws.com" },
              "Action": "s3:ListBucket",
              "Resource": { "Fn::GetAtt": ["SiteBucket", "Arn"] },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": { "Fn::Sub": "${AWS::StackName}-origin" },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": { "Fn::Sub": "${AWS::StackName}-cache" },
          "Comment": "Honour each object's Cache-Control; nothing from the viewer in the key",
          "MinTTL": 0,
          "DefaultTTL": 300,
          "MaxTTL": 31536000,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": { "CookieBehavior": "none" },
            "HeadersConfig": { "HeaderBehavior": "none" },
            "QueryStringsConfig": { "QueryStringBehavior": "none" }
          }
        }
      }
    },
    "Headers": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": { "Fn::Sub": "${AWS::StackName}-headers" },
          "Comment": "Security headers and the Content-Security-Policy of a game that is never framed",
          "SecurityHeadersConfig": {
            "ContentTypeOptions": { "Override": true },
            "ReferrerPolicy": {
              "ReferrerPolicy": "strict-origin-when-cross-origin",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "FrameOptions": { "FrameOption": "DENY", "Override": true },
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://tinylytics.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.micro.blog https://tinylytics.app https://playdate.thingelstad.xyz; font-src 'self'; connect-src 'self' wss://throwingwood-pitches.throwingwood.workers.dev https://throwingwood-pitches.throwingwood.workers.dev https://tinylytics.app; media-src 'self' data: blob: https://playdate.thingelstad.xyz; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://buttondown.com; frame-ancestors 'none'",
              "Override": true
            }
          }
        }
      }
    },
    "ViewerRequestFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-viewer-request" },
        "AutoPublish": true,
        "FunctionConfig": {
          "Runtime": "cloudfront-js-2.0",
          "Comment": "A pitch at any code is the one game page; directory routes to index.html; extensionless paths 301 to the slash form"
        },
        "FunctionCode": "// The site's viewer request function (CloudFront Functions, JavaScript\n// runtime 2.0). infra/site.json carries this file as its FunctionCode\n// (tools/infra.mjs copies it in before every plan; tests/site fails when the\n// two differ), and the preview server runs this same file.\n//\n//   /p/<code>        any code serves the one game page, /pitch/index.html\n//   /e/<code>        the embed of that pitch, /embed/index.html\n//   /og/<code>.png   that pitch's share image; the static one, /share/kubb.png,\n//                    is what it falls back to\n//   /p, /p/          302 to a pitch with a new code (for a browser without scripts)\n//   /web, /web/      301 to /#play, keeping the query: the web game's page was\n//                    folded into the landing page (the 1.0 design, 2026-11-21)\n//   /x/         /x/index.html\n//   /x          301 to /x/, keeping the query\n//\n// The site's address is https://throwingwood.com (since 2026-11-17). The\n// old address and www answer every route here with a 301 to the same path\n// and query there, so links and embeds already shared keep working. Any\n// other host (the preview on 127.0.0.1) is served as it is.\nvar HOME = \"https://throwingwood.com\";\nvar MOVED_HOSTS = {\n  \"kubb.thingelstad.xyz\": true,\n  \"www.throwingwood.com\": true,\n};\n\n// A code is 8 to 24 characters from the alphabet below, the pitch code's\n// own rule (PITCH_CODE in backend/api/checks.mjs); the home page makes 8. Any other\n// /p/ address is not a pitch and ends at the 404.\n//\n// The three pitch routes also carry the code as the query string `pitch`.\n// Their behaviours send them to the pages function (backend/pages, which\n// reads the pitch's records and writes its share tags and image) with the\n// static file as the failover origin, so the rewritten address is what the\n// bucket serves when the function cannot answer. Only `pitch` and `v` reach\n// the function or the cache key; the page's own query (?solo=1) stays in the\n// browser's address.\nvar PITCH_ROUTES = [\n  [/^\\/p\\/([2-9a-hjkmnp-z]{8,24})\\/?$/, \"/pitch/index.html\"],\n  [/^\\/e\\/([2-9a-hjkmnp-z]{8,24})\\/?$/, \"/embed/index.html\"],\n  [/^\\/og\\/([2-9a-hjkmnp-z]{8,24})\\.png$/, \"/share/kubb.png\"],\n];\n\nfunction handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  var query = Object.keys(request.querystring)\n    .map(function (k) {\n      var v = request.querystring[k];\n      return v.multiValue\n        ? v.multiValue\n            .map(function (m) {\n              return k + \"=\" + m.value;\n            })\n            .join(\"&\")\n        : k + \"=\" + v.value;\n    })\n    .join(\"&\");\n  var host =\n    request.headers && request.headers.host && request.headers.host.value;\n  if (MOVED_HOSTS[host])\n    return {\n      statusCode: 301,\n      statusDescription: \"Moved Permanently\",\n      headers: { location: { value: HOME + uri + (query ? \"?\" + query : \"\") } },\n    };\n  if (uri === \"/.well-known/apple-app-site-association\") return request;\n  if (uri === \"/web\" || uri === \"/web/\" || uri === \"/web/index.html\")\n    return {\n      statusCode: 301,\n      statusDescription: \"Moved Permanently\",\n      headers: {\n        location: { value: \"/\" + (query ? \"?\" + query : \"\") + \"#play\" },\n      },\n    };\n  if (uri === \"/p\" || uri === \"/p/\") {\n    var alphabet = \"abcdefghjkmnpqrstuvwxyz23456789\";\n    var code = \"\";\n    for (var i = 0; i < 8; i++)\n      code += alphabet.charAt(Math.floor(Math.random() * alphabet.length));\n    return {\n      statusCode: 302,\n      statusDescription: \"Found\",\n      headers: {\n        location: { value: \"/p/\" + code + (query ? \"?\" + query : \"\") },\n        \"cache-control\": { value: \"no-store\" },\n      },\n    };\n  }\n  for (var r = 0; r < PITCH_ROUTES.length; r++) {\n    var m = uri.match(PITCH_ROUTES[r][0]);\n    if (m) {\n      request.uri = PITCH_ROUTES[r][1];\n      request.querystring.pitch = { value: m[1] };\n      return request;\n    }\n  }\n  if (uri.endsWith(\"/\")) request.uri = uri + \"index.html\";\n  else if (uri.split(\"/\").pop().indexOf(\".\") === -1)\n    return {\n      statusCode: 301,\n      statusDescription: \"Moved Permanently\",\n      headers: { location: { value: uri + \"/\" + (query ? \"?\" + query : \"\") } },\n    };\n  return request;\n}\n"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Kubb: Throwing Wood on the web",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "WebACLId": { "Fn::ImportValue": "edge-waf-WebAclArn" },
          "DefaultRootObject": "index.html",
          "Aliases": [
            "throwingwood.com",
            "www.throwingwood.com",
            "kubb.thingelstad.xyz"
          ],
          "ViewerCertificate": {
            "AcmCertificateArn": { "Ref": "Certificate" },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Origins": [
            {
              "Id": "website",
              "DomainName": {
                "Fn::GetAtt": ["SiteBucket", "RegionalDomainName"]
              },
              "OriginAccessControlId": { "Ref": "OriginAccess" },
              "S3OriginConfig": { "OriginAccessIdentity": "" }
            },
            {
              "Fn::If": [
                "HasPages",
                {
                  "Id": "pages",
                  "DomainName": {
                    "Fn::GetAtt": ["PagesEndpoint", "DomainName"]
                  },
                  "OriginAccessControlId": { "Ref": "PagesOriginAccess" },
                  "CustomOriginConfig": {
                    "HTTPSPort": 443,
                    "OriginProtocolPolicy": "https-only",
                    "OriginSSLProtocols": ["TLSv1.2"],
                    "OriginReadTimeout": 15
                  }
                },
                { "Ref": "AWS::NoValue" }
              ]
            },
            {
              "Fn::If": [
                "HasApi",
                {
                  "Id": "api",
                  "DomainName": { "Ref": "ApiDomain" },
                  "CustomOriginConfig": {
                    "HTTPSPort": 443,
                    "OriginProtocolPolicy": "https-only",
                    "OriginSSLProtocols": ["TLSv1.2"],
                    "OriginReadTimeout": 30
                  }
                },
                { "Ref": "AWS::NoValue" }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "website",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD"],
            "CachedMethods": ["GET", "HEAD"],
            "Compress": true,
            "CachePolicyId": { "Ref": "CachePolicy" },
            "ResponseHeadersPolicyId": { "Ref": "Headers" },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "ViewerRequestFunction",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            }
          ],
          "CacheBehaviors": [
            {
              "Fn::If": [
                "HasApi",
                {
                  "PathPattern": "/api/*",
                  "TargetOriginId": "api",
                  "ViewerProtocolPolicy": "https-only",
                  "AllowedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS",
                    "PUT",
                    "PATCH",
                    "POST",
                    "DELETE"
                  ],
                  "CachedMethods": ["GET", "HEAD"],
                  "Compress": true,
                  "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
                  "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac"
                },
                { "Ref": "AWS::NoValue" }
              ]
            },
            {
              "PathPattern": "/p/*",
              "TargetOriginId": {
                "Fn::If": ["HasPages", "pages-or-static", "website"]
              },
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": ["GET", "HEAD"],
              "CachedMethods": ["GET", "HEAD"],
              "Compress": true,
              "CachePolicyId": { "Ref": "PagesCachePolicy" },
              "ResponseHeadersPolicyId": { "Ref": "Headers" },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "ViewerRequestFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ]
            },
            {
              "PathPattern": "/e/*",
              "TargetOriginId": {
                "Fn::If": ["HasPages", "pages-or-static", "website"]
              },
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": ["GET", "HEAD"],
              "CachedMethods": ["GET", "HEAD"],
              "Compress": true,
              "CachePolicyId": { "Ref": "PagesCachePolicy" },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "ViewerRequestFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                },
                {
                  "EventType": "viewer-response",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "EmbedResponseFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ]
            },
            {
              "PathPattern": "/og/*",
              "TargetOriginId": {
                "Fn::If": ["HasPages", "pages-or-static", "website"]
              },
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": ["GET", "HEAD"],
              "CachedMethods": ["GET", "HEAD"],
              "Compress": true,
              "CachePolicyId": { "Ref": "PagesCachePolicy" },
              "ResponseHeadersPolicyId": { "Ref": "Headers" },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "ViewerRequestFunction",
                      "FunctionMetadata.FunctionARN"
                    ]
                  }
                }
              ]
            }
          ],
          "OriginGroups": {
            "Fn::If": [
              "HasPages",
              {
                "Quantity": 1,
                "Items": [
                  {
                    "Id": "pages-or-static",
                    "FailoverCriteria": {
                      "StatusCodes": {
                        "Quantity": 5,
                        "Items": [403, 500, 502, 503, 504]
                      }
                    },
                    "Members": {
                      "Quantity": 2,
                      "Items": [
                        { "OriginId": "pages" },
                        { "OriginId": "website" }
                      ]
                    }
                  }
                ]
              },
              { "Ref": "AWS::NoValue" }
            ]
          }
        }
      }
    },
    "SiteRecordA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": { "Ref": "HostedZoneId" },
        "Name": "kubb.thingelstad.xyz.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "SiteRecordAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": { "Ref": "HostedZoneId" },
        "Name": "kubb.thingelstad.xyz.",
        "Type": "AAAA",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "ThrowingWoodApexRecordA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
        },
        "Name": "throwingwood.com.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "ThrowingWoodApexRecordAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
        },
        "Name": "throwingwood.com.",
        "Type": "AAAA",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "ThrowingWoodWwwRecordA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
        },
        "Name": "www.throwingwood.com.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "ThrowingWoodWwwRecordAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Fn::ImportValue": "projects-dns-zone-throwingwood-com"
        },
        "Name": "www.throwingwood.com.",
        "Type": "AAAA",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": { "Fn::GetAtt": ["Distribution", "DomainName"] }
        }
      }
    },
    "AccessLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/kubb-xyz/web-access",
        "RetentionInDays": 731
      }
    },
    "AccessLogSource": {
      "Type": "AWS::Logs::DeliverySource",
      "Properties": {
        "Name": "kubb-xyz-web-access",
        "LogType": "ACCESS_LOGS",
        "ResourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "AccessLogDestination": {
      "Type": "AWS::Logs::DeliveryDestination",
      "Properties": {
        "Name": "kubb-xyz-web-access",
        "DestinationResourceArn": { "Fn::GetAtt": ["AccessLogGroup", "Arn"] },
        "OutputFormat": "json"
      }
    },
    "AccessLogDelivery": {
      "Type": "AWS::Logs::Delivery",
      "Properties": {
        "DeliverySourceName": { "Ref": "AccessLogSource" },
        "DeliveryDestinationArn": {
          "Fn::GetAtt": ["AccessLogDestination", "Arn"]
        },
        "RecordFields": [
          "timestamp(ms)",
          "cs-method",
          "cs-uri-stem",
          "sc-status",
          "sc-bytes",
          "sc-range-start",
          "sc-range-end",
          "time-taken",
          "time-to-first-byte",
          "x-edge-result-type",
          "x-edge-detailed-result-type",
          "x-edge-location",
          "cs-protocol",
          "cs(User-Agent)"
        ]
      }
    },
    "CodeBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Fn::Sub": "${AWS::StackName}-code-${AWS::AccountId}" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
            },
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": { "NoncurrentDays": 30 },
              "ExpiredObjectDeleteMarker": true
            }
          ]
        }
      }
    },
    "CodeBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "CodeBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "LambdaReadsPagesRevisions",
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": ["s3:GetObject", "s3:GetObjectVersion"],
              "Resource": { "Fn::Sub": "${CodeBucket.Arn}/pages/*" },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": { "Ref": "AWS::AccountId" }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:web-function/${AWS::StackName}-pages/*"
                  }
                }
              }
            },
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["CodeBucket", "Arn"] },
                { "Fn::Sub": "${CodeBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    },
    "PagesLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasPages",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda-web/${AWS::StackName}-pages"
        },
        "RetentionInDays": 30
      }
    },
    "PagesLocalLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasPages",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda-web/${AWS::StackName}-pages.local"
        },
        "RetentionInDays": 30
      }
    },
    "PagesRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasPages",
      "Properties": {
        "Description": "Pitch pages function: reads a pitch's state, kept replay and reel, writes its own logs",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "pages",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadPitches",
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${PitchTable}"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": ["pitch#*"]
                    }
                  }
                },
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": [
                    { "Fn::GetAtt": ["PagesLogs", "Arn"] },
                    { "Fn::GetAtt": ["PagesLocalLogs", "Arn"] }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "PagesFunction": {
      "Type": "AWS::Lambda::WebFunction",
      "Condition": "HasPages",
      "Properties": { "FunctionName": { "Fn::Sub": "${AWS::StackName}-pages" } }
    },
    "PagesRevision": {
      "Type": "AWS::Lambda::WebFunctionRevision",
      "Condition": "HasPages",
      "DependsOn": ["PagesFunction", "CodeBucketPolicy"],
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-pages" },
        "Description": { "Ref": "PagesCodeKey" },
        "BuildConfig": {
          "CodeConfig": {
            "S3Object": {
              "Bucket": { "Ref": "CodeBucket" },
              "Key": { "Ref": "PagesCodeKey" }
            }
          },
          "RuntimeConfig": { "Runtime": "nodejs24.x" }
        },
        "ServiceConfig": {
          "ExecutionRoleArn": { "Fn::GetAtt": ["PagesRole", "Arn"] },
          "TimeoutSeconds": 15,
          "MaxConcurrencyPerEnvironment": 8,
          "EnvironmentVariables": {
            "TABLE": { "Ref": "PitchTable" },
            "SITE": "https://throwingwood.com"
          },
          "TelemetryConfig": {
            "LoggingConfig": {
              "LogGroup": { "Ref": "PagesLogs" },
              "ApplicationLogLevel": "INFO",
              "SystemLogLevel": "INFO"
            }
          }
        }
      }
    },
    "PagesEndpoint": {
      "Type": "AWS::Lambda::WebFunctionEndpoint",
      "Condition": "HasPages",
      "DependsOn": "PagesFunction",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-pages" },
        "EndpointName": "live",
        "EndpointType": "HomeRegion",
        "AuthType": "IamAuth",
        "RevisionWeights": [
          {
            "RevisionId": { "Fn::GetAtt": ["PagesRevision", "RevisionId"] },
            "Weight": 100
          }
        ],
        "ScalingConfig": { "MaxEnvironments": 2 },
        "ThrottleConfig": { "RateLimit": 100 }
      }
    },
    "PagesAccess": {
      "Type": "AWS::Lambda::ResourcePolicy",
      "Condition": "HasPages",
      "Properties": {
        "ResourceArn": { "Fn::GetAtt": ["PagesEndpoint", "FunctionArn"] },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "SiteDistributionInvokesLive",
              "Effect": "Allow",
              "Principal": { "Service": "cloudfront.amazonaws.com" },
              "Action": "lambda:InvokeWebFunctionEndpoint",
              "Resource": { "Fn::GetAtt": ["PagesEndpoint", "EndpointArn"] },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "PagesOriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Condition": "HasPages",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": { "Fn::Sub": "${AWS::StackName}-pages" },
          "Description": "CloudFront signs its requests to the pitch pages function",
          "OriginAccessControlOriginType": "lambda",
          "SigningBehavior": "always-amz-auth",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "PagesCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": { "Fn::Sub": "${AWS::StackName}-pages" },
          "Comment": "A pitch's page or image: keyed by its code (pitch, set by the viewer request function) and the image's version (v)",
          "MinTTL": 0,
          "DefaultTTL": 60,
          "MaxTTL": 86400,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": { "CookieBehavior": "none" },
            "HeadersConfig": { "HeaderBehavior": "none" },
            "QueryStringsConfig": {
              "QueryStringBehavior": "whitelist",
              "QueryStrings": ["pitch", "v"]
            }
          }
        }
      }
    },
    "EmbedResponseFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": { "Fn::Sub": "${AWS::StackName}-embed-response" },
        "AutoPublish": true,
        "FunctionConfig": {
          "Runtime": "cloudfront-js-2.0",
          "Comment": "The embed at /e/<code>: the site security headers, but any site may frame it"
        },
        "FunctionCode": "// The embed's response headers (/e/*, viewer response). Written by\n// tools/site-template.mjs from infra/embed-response.mjs and src/site/csp.mjs:\n// edit those, never this copy.\nvar HEADERS = {\n  \"content-security-policy\": \"default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://tinylytics.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.micro.blog https://tinylytics.app; font-src 'self'; connect-src 'self' wss://throwingwood-pitches.throwingwood.workers.dev https://throwingwood-pitches.throwingwood.workers.dev https://tinylytics.app; media-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors *\",\n  \"strict-transport-security\": \"max-age=31536000\",\n  \"x-content-type-options\": \"nosniff\",\n  \"referrer-policy\": \"strict-origin-when-cross-origin\"\n};\n\nfunction handler(event) {\n  var headers = event.response.headers;\n  delete headers[\"x-frame-options\"];\n  for (var name in HEADERS) headers[name] = { value: HEADERS[name] };\n  return event.response;\n}\n"
      }
    },
    "ReelsLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasReels",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-reels" },
        "RetentionInDays": 30
      }
    },
    "ReelsRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasReels",
      "Properties": {
        "Description": "Highlight reel function: reads a kept replay, updates its reel item, writes the reel under reels/ in the site bucket and its own logs",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "reels",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadKeptReplay",
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${PitchTable}"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": ["pitch#*"]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": ["pk", "sk", "v", "z", "s", "exp"]
                    },
                    "StringEqualsIfExists": {
                      "dynamodb:Select": "SPECIFIC_ATTRIBUTES"
                    }
                  }
                },
                {
                  "Sid": "UpdateReelItem",
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${PitchTable}"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": ["pitch#*"]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": [
                        "pk",
                        "sk",
                        "job",
                        "state",
                        "tries",
                        "tall",
                        "wide",
                        "edit",
                        "seconds",
                        "done",
                        "why"
                      ]
                    },
                    "StringEqualsIfExists": {
                      "dynamodb:ReturnValues": ["NONE", "UPDATED_NEW"]
                    }
                  }
                },
                {
                  "Sid": "WriteReels",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": { "Fn::Sub": "${SiteBucket.Arn}/reels/*" }
                },
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": { "Fn::GetAtt": ["ReelsLogs", "Arn"] }
                }
              ]
            }
          }
        ]
      }
    },
    "ReelsLayer": {
      "Type": "AWS::Lambda::LayerVersion",
      "Condition": "HasReels",
      "Properties": {
        "LayerName": { "Fn::Sub": "${AWS::StackName}-ffmpeg" },
        "Description": "Static ffmpeg with libx264 for the reel function (infra/reels-pins.json)",
        "Content": {
          "S3Bucket": { "Ref": "CodeBucket" },
          "S3Key": { "Ref": "ReelsLayerKey" }
        },
        "CompatibleArchitectures": ["arm64"],
        "CompatibleRuntimes": ["nodejs24.x"],
        "LicenseInfo": "GPL-3.0-or-later"
      }
    },
    "ReelsFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasReels",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-reels" },
        "Description": "Renders a finished pitch's highlight reel, tall and wide MP4s, from its kept replay",
        "Runtime": "nodejs24.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "Code": {
          "S3Bucket": { "Ref": "CodeBucket" },
          "S3Key": { "Ref": "ReelsCodeKey" }
        },
        "Layers": [{ "Ref": "ReelsLayer" }],
        "MemorySize": 3008,
        "Timeout": 300,
        "ReservedConcurrentExecutions": 2,
        "Role": { "Fn::GetAtt": ["ReelsRole", "Arn"] },
        "LoggingConfig": {
          "LogGroup": { "Ref": "ReelsLogs" },
          "LogFormat": "JSON"
        },
        "Environment": {
          "Variables": {
            "TABLE": { "Ref": "PitchTable" },
            "SITE_BUCKET": { "Ref": "SiteBucket" },
            "REEL_ENGINES": { "Ref": "ReelEngines" },
            "FFMPEG": "/opt/bin/ffmpeg"
          }
        }
      }
    },
    "ReelsInvokeConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Condition": "HasReels",
      "Properties": {
        "FunctionName": { "Ref": "ReelsFunction" },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 1,
        "MaximumEventAgeInSeconds": 900
      }
    }
  },
  "Outputs": {
    "SiteBucket": {
      "Value": { "Ref": "SiteBucket" },
      "Description": "Private website origin"
    },
    "CertificateArn": {
      "Value": { "Ref": "Certificate" },
      "Description": "kubb.thingelstad.xyz HTTPS certificate"
    },
    "DistributionId": {
      "Value": { "Ref": "Distribution" },
      "Description": "Site distribution"
    },
    "DistributionDomain": {
      "Value": { "Fn::GetAtt": ["Distribution", "DomainName"] },
      "Description": "CloudFront domain the alias records point at"
    },
    "AccessLogGroup": {
      "Value": { "Ref": "AccessLogGroup" },
      "Description": "CloudFront access log, 731 days, no client IPs or query strings"
    },
    "CodeBucket": {
      "Value": { "Ref": "CodeBucket" },
      "Description": "Private bucket for the functions' code bundles"
    },
    "PagesEndpoint": {
      "Value": {
        "Fn::If": [
          "HasPages",
          { "Fn::GetAtt": ["PagesEndpoint", "DomainName"] },
          ""
        ]
      },
      "Description": "The pitch pages function's live endpoint, the origin of /p/, /e/ and /og/; empty while it is off"
    },
    "PagesRevision": {
      "Value": {
        "Fn::If": [
          "HasPages",
          { "Fn::GetAtt": ["PagesRevision", "RevisionId"] },
          ""
        ]
      },
      "Description": "The revision the live endpoint serves"
    },
    "ReelsFunctionArn": {
      "Value": {
        "Fn::If": ["HasReels", { "Fn::GetAtt": ["ReelsFunction", "Arn"] }, ""]
      },
      "Description": "The highlight reel function the api function invokes; empty while it is off"
    },
    "ReelEngines": {
      "Value": { "Fn::If": ["HasReels", { "Ref": "ReelEngines" }, ""] },
      "Description": "The engine major.minors the reel function renders; empty while it is off"
    },
    "ApiRoute": {
      "Condition": "HasApi",
      "Description": "The api function behind the site",
      "Value": "/api/*"
    }
  }
}
