{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "kubb.thingelstad.xyz GitHub OIDC publication from main only: the site files and the rooms function code",
  "Parameters": {
    "SiteBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+"
    },
    "DistributionId": {
      "Type": "String",
      "AllowedPattern": "[A-Z0-9]+"
    },
    "CodeBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+",
      "Description": "The site stack's bucket for the rooms function's code bundles"
    },
    "RoomsFunctionName": {
      "Type": "String",
      "Default": "kubb-xyz-rooms-rooms",
      "AllowedPattern": "[A-Za-z0-9_-]+",
      "Description": "The rooms Lambda function (stack kubb-xyz-rooms names it <stack>-rooms)"
    },
    "RepositoryId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[0-9]+$",
      "Description": "GitHub's numeric id of jthingelstad/kubb.thingelstad.xyz. Empty until the repository exists: then the trust matches the repository by name with any id."
    },
    "ApiFunctionName": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[A-Za-z0-9_-]+$",
      "Description": "The api Lambda function throwing-wood-api (stack throwing-wood-pitches output ApiFunctionName). Empty: the role cannot touch it."
    }
  },
  "Conditions": {
    "RepositoryPinned": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "RepositoryId"
            },
            ""
          ]
        }
      ]
    },
    "HasApi": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "ApiFunctionName" }, ""] }]
    }
  },
  "Resources": {
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Publishes the verified main build of kubb.thingelstad.xyz and its rooms function code",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "Fn::If": [
                  "RepositoryPinned",
                  {
                    "StringEquals": {
                      "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                      "token.actions.githubusercontent.com:sub": {
                        "Fn::Sub": "repo:jthingelstad@5351/kubb.thingelstad.xyz@${RepositoryId}:ref:refs/heads/main"
                      }
                    }
                  },
                  {
                    "StringEquals": {
                      "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
                    },
                    "StringLike": {
                      "token.actions.githubusercontent.com:sub": "repo:jthingelstad@5351/kubb.thingelstad.xyz@*:ref:refs/heads/main"
                    }
                  }
                ]
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SiteDelivery",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:DeleteObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}/.well-known/apple-app-site-association"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:GetDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "RoomsCodeDelivery",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${CodeBucket}/rooms/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:GetFunction",
                    "lambda:GetFunctionConfiguration",
                    "lambda:UpdateFunctionCode"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${RoomsFunctionName}"
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "HasApi",
              {
                "PolicyName": "ApiCodeDelivery",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": ["s3:GetObject", "s3:PutObject"],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${CodeBucket}/api/*"
                      }
                    },
                    {
                      "Effect": "Allow",
                      "Action": [
                        "lambda:GetFunction",
                        "lambda:GetFunctionConfiguration",
                        "lambda:UpdateFunctionCode"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${ApiFunctionName}"
                      }
                    }
                  ]
                }
              },
              { "Ref": "AWS::NoValue" }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": ["DeploymentRole", "Arn"]
      },
      "Description": "GitHub OIDC deployment identity (repository variable AWS_DEPLOY_ROLE_ARN)"
    }
  }
}
